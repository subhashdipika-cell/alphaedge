{
  "name": "alphaedge",
  "version": "4.0.0",
  "description": "AlphaEdge — Indian index-options buying decision-support: Trending-OI intelligence, a 0-100 Option Buying Score, trade-style engine, premium-tracked paper trading, and a self-learning R&D loop.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Subhash",
  "keywords": [
    "options",
    "trading",
    "nifty",
    "banknifty",
    "dhan",
    "open-interest",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\""
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10"
  }
}
