# ─────────────────────────────────────────────────────────────────────────────
# AlphaEdge — example environment file
# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".
#
# IMPORTANT SECURITY NOTE
# This app currently stores API keys in the browser (localStorage) and calls the
# AI / broker APIs directly from the browser. That is fine for LOCAL use on your
# own machine, but any key shipped to a PUBLIC website can be read by visitors.
# If you ever deploy AlphaEdge publicly, move these keys behind a small backend
# proxy and keep them in server-side env vars instead of the browser.
# ─────────────────────────────────────────────────────────────────────────────

# AI providers (set whichever you use; the app picks the active one)
VITE_ANTHROPIC_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# Broker (Dhan)
VITE_DHAN_TOKEN=

# Telegram broadcast bot
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
